<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.9</version>
    <relativePath/>
  </parent>
  <groupId>io.givops</groupId>
  <artifactId>adapter-jira</artifactId>
  <version>0.3.0-SNAPSHOT</version>
  <name>GivOps Jira Cloud adapter</name>
  <description>Independent Jira Cloud ticket, test report and release operations.</description>
  <properties>
    <java.version>25</java.version>
    <adapter-sdk.version>0.3.0-SNAPSHOT</adapter-sdk.version>
  </properties>
  <licenses><license><name>Apache License, Version 2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0</url><distribution>repo</distribution></license></licenses>
  <url>https://github.com/givops/adapter-jira</url>
  <dependencies>
    <dependency>
      <groupId>io.givops</groupId><artifactId>adapter-spring-boot</artifactId><version>${adapter-sdk.version}</version>
    </dependency>
    <dependency><groupId>tools.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>io.givops</groupId><artifactId>adapter-testkit</artifactId><version>${adapter-sdk.version}</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory><filtering>false</filtering><excludes><exclude>META-INF/givops/adapter-jira.properties</exclude><exclude>META-INF/givops-adapter.properties</exclude></excludes></resource>
      <resource><directory>src/main/resources</directory><filtering>true</filtering><includes><include>META-INF/givops/adapter-jira.properties</include><include>META-INF/givops-adapter.properties</include></includes></resource>
    </resources>
    <plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><configuration><archive><manifest><addDefaultImplementationEntries>true</addDefaultImplementationEntries></manifest></archive></configuration></plugin></plugins>
  </build>
</project>
